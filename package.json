{
  "name": "resume-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time resume editor. Edit JSON Resume data from Keystone CMS, live preview across themes, save on demand.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @resume-studio/web dev",
    "dev:render": "pnpm --filter @resume-studio/render-service dev",
    "dev:auth": "pnpm --filter @resume-studio/auth-service dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "codegen": "pnpm --filter @resume-studio/graphql-client codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:dev": "pnpm --filter @resume-studio/auth-service db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @resume-studio/auth-service db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @resume-studio/auth-service db:migrate:status",
    "db:generate": "pnpm --filter @resume-studio/auth-service db:generate",
    "db:validate": "pnpm --filter @resume-studio/auth-service db:validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0"
  }
}
