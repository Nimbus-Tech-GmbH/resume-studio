# Web app
VITE_GRAPHQL_ENDPOINT=http://localhost:3000/api/graphql
VITE_RENDER_ENDPOINT=http://localhost:8787

# Render service
RENDER_PORT=8787
RENDER_HOST=127.0.0.1
RENDER_ALLOWED_IPS=127.0.0.1,::1
RENDER_CORS_ORIGIN=http://localhost:5173
RENDER_CACHE_MAX=100

# Auth service
AUTH_PORT=4000
AUTH_HOST=127.0.0.1
AUTH_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173

# Prisma
DATABASE_URL=postgres://admin:dev-auth-pass@127.0.0.1:5434/resume-auth
DIRECT_URL=postgres://admin:dev-auth-pass@127.0.0.1:5434/resume-auth
DATABASE_URL_PROD=xxx
DIRECT_URL_PROD=xxx

# Amazon Cognito
COGNITO_CLIENT_ID=CHANGE_ME
COGNITO_CLIENT_SECRET=CHANGE_ME
COGNITO_DOMAIN=CHANGE_ME.auth.eu-central-1.amazoncognito.com
COGNITO_REGION=eu-central-1
COGNITO_USERPOOL_ID=eu-central-1_CHANGE_ME
BETTER_AUTH_SECRET=dev-only-secret-change-me
